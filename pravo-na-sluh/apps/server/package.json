{
  "name": "@pravo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed-cli.ts",
    "bot:setup": "tsx src/telegram/setup-cli.ts",
    "billing:refund": "tsx src/billing/refund-cli.ts",
    "notify:release": "tsx src/notifications/release-cli.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.6",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@pravo/shared": "*",
    "drizzle-orm": "^0.44.4",
    "fastify": "^5.4.0",
    "pg": "^8.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.4"
  }
}
