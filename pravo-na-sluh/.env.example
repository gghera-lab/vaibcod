# «Право на слух» — пример конфигурации. Скопируйте в .env и заполните. Не коммитьте .env с секретами.

# ── Режим
NODE_ENV=development
PORT=8080
# Публичный HTTPS-адрес (обязателен для Telegram и production), например https://pravo.example.ru
PUBLIC_URL=

# ── База данных
# Пусто — встроенный PGlite в ./data (только разработка и демо).
# Production: postgres://user:password@host:5432/pravo
DATABASE_URL=

# ── Telegram
# Токен от @BotFather (секрет! только на сервере)
BOT_TOKEN=
BOT_USERNAME=
# Случайная строка 32+ символов: секрет webhook (заголовок X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=
# Сколько секунд initData считаются действительными
INIT_DATA_MAX_AGE_SEC=86400
# Telegram ID администраторов через запятую (доступ к /admin)
ADMIN_TELEGRAM_IDS=

# ── Режим разработки: вход без Telegram (тестовый пользователь). В production запрещён.
DEV_AUTH=true

# ── Оплата: stars (Telegram Stars) | sandbox (тест, без денег) | disabled
PAYMENTS_MODE=sandbox

# ── Аудио
# Каталог с аудио (storage/audio по умолчанию) и базовый URL (CDN) для файлов
# AUDIO_DIR=
# AUDIO_BASE_URL=https://cdn.example.ru/audio

# ── Синтез речи (Yandex SpeechKit API v3) — для продакшн-озвучки: npm run audio:synthesize -- --voice speechkit-ermil
# Api-Key сервисного аккаунта с ролью ai.speechkit-tts.user
YANDEX_API_KEY=
# или IAM-токен + каталог
YANDEX_IAM_TOKEN=
YANDEX_FOLDER_ID=

# ── Реферальная программа: максимум бонусов (по 7 дней Pro) на одного пригласившего
REFERRAL_MAX_REWARDS=10

# ── Поддержка и юридические документы
SUPPORT_CONTACT=@pravo_na_sluh_support
TERMS_VERSION=2026-10-14
